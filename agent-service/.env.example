# 应用配置
APP_NAME=安心保
APP_HOST=0.0.0.0
APP_PORT=8001
APP_DEBUG=true
JWT_SECRET_KEY=replace-with-random-secret-key-at-least-32-chars
JWT_ACCESS_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=7

# PostgreSQL 数据库配置
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=insurance
DB_USER=insurance
DB_PASSWORD=insurance123
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# 模型配置（阿里云百炼 DashScope 兼容接口）
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY
CHAT_MODEL=qwen3.8-flash

# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
LOGGING_LEVEL=INFO

# RAG 与向量数据库配置
MINERU_TOKEN=YOUR_MINERU_TOKEN
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
